    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "redux-mock-store": "^1.5.5",
    "sass": "^1.106.1",
    "stylelint": "^17.16.0",
    "stylelint-config-recess-order": "^7.8.2",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-order": "^8.1.2",
    "ts-jest": "^29.4.15",
