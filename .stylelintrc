{
  "extends": [
    "stylelint-config-standard-scss",
    "stylelint-config-recess-order"
  ],
  "rules": {
    "selector-class-pattern": [
      "^[a-z][a-zA-Z0-9]*$",
      { "message": "Expected class selector to be lowerCamelCase (CSS Modules)" }
    ],
    "scss/dollar-variable-pattern": [
      "^(z_)?[a-z][a-zA-Z0-9]*$",
      { "message": "Expected variable name to be lowerCamelCase (z_ prefix allowed for z-index)" }
    ],
    "declaration-no-important": true,
    "selector-max-universal": 1,
    "selector-max-id": 0,
    "no-descending-specificity": null,
    "no-duplicate-selectors": null,
    "block-no-empty": null
  }
}
